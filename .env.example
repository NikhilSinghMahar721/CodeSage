# CodeSage Configuration

# LLM Provider: gemini | openai | ollama | mock
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama Settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# GitHub Integration (optional, for fetching private PR diffs or avoiding rate limits)
GITHUB_TOKEN=

# Retrieval & Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_MODE=hybrid
TOP_K=5

# Storage directories (relative to project root)
CHROMA_PERSIST_DIR=.chroma_db
REPOS_CACHE_DIR=.repos
